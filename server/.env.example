# Copy this file to .env and fill in the values. Never commit .env.

PORT=5000
MONGO_URL=mongodb://localhost:27017/map_data_generator

# Any long random string — used to sign login tokens
JWT_SECRET=

# Where the frontend runs (used for CORS)
FRONTEND_URL=http://localhost:5173

# https://dashboard.razorpay.com -> Settings -> API Keys (use Test Mode while developing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# https://www.openwebninja.com -> API key for local business search
OPENWEBNINJA_API_KEY=

# Dev only: when true and Razorpay keys are missing, checkout activates a plan
# without a real payment. Ignored when NODE_ENV=production.
ALLOW_MOCK_PAYMENTS=true
